<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>AgentAblate report</title>
<style>body{font:15px system-ui;margin:2rem;color:#222}table{border-collapse:collapse;width:100%}th,td{border:1px solid #bbb;padding:.5rem;text-align:left}th{background:#eee}.notice{padding:.75rem;background:#fff4cc}</style>
</head><body><h1>AgentAblate report</h1>
<p>Config hash: {{ report.config_hashes|join(', ') or 'none' }}<br>
Adapter/version: agent_id / agentablate {{ report.version }}<br>
Repetitions: {{ report.repetitions }}</p>
{% if not report.rows %}<p class="notice">No trial results.</p>{% else %}
{% if not report.has_baseline %}<p class="notice">No baseline variant was found.</p>{% endif %}
<table><thead><tr><th>Agent</th><th>Variant</th><th>Task</th><th>Success</th><th>Success rate</th><th>Mean duration (s)</th><th>Failure reason</th></tr></thead><tbody>
{% for row in report.rows %}<tr><td>{{ row.agent_id }}</td><td>{{ row.variant_id }}</td><td>{{ row.task_ids|join(', ') }}</td><td>{{ row.success_count }}/{{ row.trial_count }}</td><td>{{ '%.1f%%'|format(row.success_rate * 100) }}</td><td>{{ '%.3f'|format(row.mean_duration) }}</td><td>{{ failure_text(row) }}</td></tr>{% endfor %}
</tbody></table>{% endif %}</body></html>
